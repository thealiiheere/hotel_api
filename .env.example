# Copy to .env and replace with real values. Never commit the real .env file.

# PostgreSQL connection (SQLAlchemy URL, psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://hotel_user:change_me@localhost:5432/hotel_db

# JWT signing key — at least 32 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Timezone used to decide what "today" is for check-in / cancellation rules
TIMEZONE=Asia/Tashkent
